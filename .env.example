PORT=3000
# Used in attendance QR links. For phones, use this computer's LAN address.
BASE_URL=http://localhost:3000
# Optional, enables the AI assistant. Choose an available OpenRouter model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Set to 1 only behind HTTPS
COOKIE_SECURE=0

# Vercel: connect a private Blob store to set BLOB_READ_WRITE_TOKEN.
# Leave unset locally to keep using your existing SQLite database.
BLOB_READ_WRITE_TOKEN=
